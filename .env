# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# OpenSky Network Credentials (Optional - empty for anonymous)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Caching & Rate Limit
CACHE_TTL_SECONDS=10

# Default Bounding Box (Iran Airspace)
DEFAULT_LAMIN=24.0
DEFAULT_LOMIN=44.0
DEFAULT_LAMAX=40.0
DEFAULT_LOMAX=64.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
