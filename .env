# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# OpenSky Network Credentials (Optional - empty for anonymous)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Network & Proxy Settings (Set PROXY_URL if OpenSky is unreachable or blocked in your network)
# Examples: PROXY_URL=http://127.0.0.1:10809 or PROXY_URL=http://127.0.0.1:7890 or PROXY_URL=socks5://127.0.0.1:10808
PROXY_URL=
USE_SYSTEM_PROXY=false
OPENSKY_REQUEST_TIMEOUT=25.0
OPENSKY_CONNECT_TIMEOUT=15.0

# Caching & Fallback
CACHE_TTL_SECONDS=10
FALLBACK_SAMPLE_CACHE=true

# Default Bounding Box (Iran Airspace)
DEFAULT_LAMIN=24.0
DEFAULT_LOMIN=44.0
DEFAULT_LAMAX=40.0
DEFAULT_LOMAX=64.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://www.asemanyar.ir","http://127.0.0.1:5173","http://127.0.0.1:3000"]

