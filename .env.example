# ==========================================
# OpenSky Network API Backend Configuration
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# OpenSky Network Credentials (optional for anonymous access)
# Register for free at https://opensky-network.org to get higher rate limits:
# Anonymous: 10s rate limit, ~400 credits/day
# Authenticated: 5s rate limit, ~4000 credits/day
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# OpenSky Client ID & Secret (for OAuth token flow if configured)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Network & Timeout Configuration
OPENSKY_REQUEST_TIMEOUT=25.0
OPENSKY_CONNECT_TIMEOUT=15.0

# Proxy Configuration (Optional - set if OpenSky requires proxy in your network or region)
# Examples: PROXY_URL=http://127.0.0.1:10809 or PROXY_URL=http://127.0.0.1:7890 or PROXY_URL=socks5://127.0.0.1:10808
PROXY_URL=
USE_SYSTEM_PROXY=false

# Caching & Fallback Protection
# OpenSky updates every 5-10s. Cache TTL prevents 429 Too Many Requests errors.
CACHE_TTL_SECONDS=10
FALLBACK_SAMPLE_CACHE=true

# Default Bounding Box (Default: Iran airspace coordinates)
# Set to null or leave empty for global airspace queries
DEFAULT_LAMIN=24.0
DEFAULT_LOMIN=44.0
DEFAULT_LAMAX=40.0
DEFAULT_LOMAX=64.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://www.asemanyar.ir","http://127.0.0.1:5173","http://127.0.0.1:3000"]

clientId = "sample@gmail.com-api-client"
clientSecret = "sample0Flg0n1UNodR"