# ==========================================
# Asemanha Flight Tracking API Configuration
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# AirLabs API Configuration (https://airlabs.co/docs/flights)
AIRLABS_API_KEY=your-airlabs-api-key-here
AIRLABS_BASE_URL=https://airlabs.co/api/v9
AIRLABS_REQUEST_TIMEOUT=30.0
AIRLABS_CONNECT_TIMEOUT=20.0

# Proxy Configuration (Optional)
PROXY_URL=
USE_SYSTEM_PROXY=false

# Scheduled Sync & Quota Protection (Free API Optimization)
# Sync every 2 hours = 7200 seconds (~10-12 requests per 24 hours)
AIRLABS_SYNC_INTERVAL_SECONDS=7200
AIRLABS_MAX_DAILY_REQUESTS=10
AIRLABS_FETCH_GLOBAL=true
AIRLABS_AUTO_SYNC_ENABLED=true
AIRLABS_CACHE_FILE=app/data/aircraft_cache.json

# Caching & Fallback Protection
CACHE_TTL_SECONDS=7200
FALLBACK_SAMPLE_CACHE=true

# Default Bounding Box (Default: Iran airspace coordinates)
DEFAULT_LAMIN=24.0
DEFAULT_LOMIN=44.0
DEFAULT_LAMAX=40.0
DEFAULT_LOMAX=64.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://www.asemanyar.ir","http://127.0.0.1:5173","http://127.0.0.1:3000"]